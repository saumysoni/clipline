# Copy this file to ".env" and fill in your key.

# Which AI picks the moments and plans the thumbnails: gemini (free key, default) or openai (paid key)
AI_PROVIDER=gemini

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Only needed with AI_PROVIDER=openai. Key from https://platform.openai.com/api-keys (needs credit)
OPENAI_API_KEY=
# OpenAI model. If OpenAI retires this name, swap in a current one that can read images.
OPENAI_MODEL=gpt-5.4-mini

# Optional: lets Pit Crew read a vlog's description (not just the title) from its YouTube link.
# Free API key from Google Cloud (README step 2b).
YOUTUBE_API_KEY=

# Gemini model that picks the moments. If Google retires this name, swap in a current Flash model.
GEMINI_MODEL=gemini-3.8-flash

# Speech model: tiny, base, small (good default), medium (more accurate, slower), large-v3 (best, slowest)
WHISPER_MODEL=small

# Where the speech model runs: auto (an NVIDIA GPU if the machine has one, else the processor), cpu or cuda
WHISPER_DEVICE=auto
# How many 30-second pieces to transcribe at once (about 2x faster). 0 = one at a time.
WHISPER_BATCH_SIZE=8
# Processor threads for transcription. Empty = use every available core.
WHISPER_THREADS=

# How many vlogs are transcribed and edited at once; the rest wait their turn ("Waiting for a free spot"). Each one
# being transcribed uses WHISPER_THREADS cores (every core when empty), so on a server set JOB_SLOTS x WHISPER_THREADS
# to about the number of cores, and keep JOB_SLOTS x ~3 GB under its memory.
JOB_SLOTS=2
# At most this many of one creator's vlogs at once, so one person's ten vlogs don't hold everyone else up.
JOB_SLOTS_PER_CREATOR=1
# Biggest video file Pit Crew takes, in GB (it's sent in 8 MB pieces, so a dropped connection carries on).
MAX_UPLOAD_GB=30

# Pit Crew is English-only for now: empty means English. "auto" lets Whisper guess (not recommended).
WHISPER_LANGUAGE=

# Font name for burned-in captions (put the font file in the fonts folder)
CAPTION_FONT=Montserrat ExtraBold

# Video encoding speed: veryfast (default; 2.5x faster than medium, same look) ... medium ... slow
X264_PRESET=veryfast

# Put each Short's thumbnail in as its very first frame (0.1 s) when uploading and saving, so the creator can
# pick it as the Shorts-feed thumbnail in the YouTube app. 0 turns it off.
COVER_FRAME=1

# Privacy for "All at once, right away" uploads: public, unlisted or private
POST_NOW_PRIVACY=public

# YouTube category for whole vlogs uploaded with "Upload a vlog to YouTube" (19 = Travel & Events,
# 22 = People & Blogs, the default). Empty uses YOUTUBE_CATEGORY_ID, else 22.
YOUTUBE_VLOG_CATEGORY_ID=
# Where Google sends the creator back after signing in to YouTube. Leave empty on your own computer
# (http://localhost:8000/api/youtube/callback). On a server, set its public address, e.g.
# https://pitcrew.example.com/api/youtube/callback, and register the same address on the OAuth client.
YOUTUBE_REDIRECT_URI=
# Google OAuth client without a file (best in the cloud). Locally, the client_secret JSON file works instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Thumbnails: designed (the AI picks the best frame; Frame or Duotone look) or simple (a fixed frame + text)
THUMB_STYLE=designed
# Which AI picks the thumbnail frame: gemini (default, best at marking where things are in a frame) or openai.
# Used whatever AI_PROVIDER says; if it can't answer, the other one is tried, then the face finder.
THUMB_AI_PROVIDER=gemini
# Default look for new thumbnails: frame (the best moment, colour-graded, with text) or duotone (two-colour
# poster). Creators can switch any Short's look on its card in Review.
THUMB_LOOK=frame
# How many thumbnails are designed at the same time (most of the time is waiting for the AI)
THUMB_WORKERS=3

# Accounts. Leave empty on your own computer: Pit Crew makes a secret once and keeps it in data/secret_key.
# On a server, set a long random SECRET_KEY (it signs everyone's sign-in cookie; changing it signs everyone out).
SECRET_KEY=
# Where the accounts database lives (default data/clipline.db). On a server, point it at lasting storage.
DATABASE_PATH=
# Set to 1 when Pit Crew is served over https, so the sign-in cookie is only ever sent securely.
SESSION_COOKIE_SECURE=
# How many proxies / load balancers are in front of Pit Crew (usually 1 in the cloud), so it sees each visitor's real
# address and https. Leave empty when nothing is in front (on your computer): otherwise anyone could fake them.
TRUST_PROXY=
# The key that encrypts saved YouTube/Instagram tokens in the database. Empty = made once in data/token_key. On a
# server, keep it in the secret manager (not next to the database) and back it up: lose it and everyone reconnects.
TOKEN_KEY=

# Limits. The longest vlog Pit Crew takes, in minutes (0 = no limit), and how many minutes of vlogs one account can
# have made per calendar month (0 = no limit; set it in the cloud: each minute is transcription, AI and editing).
MAX_VLOG_MINUTES=180
MONTHLY_VLOG_MINUTES=0
# Where creators write for help: shown as Help in the sidebar and "Get help" (with a reference) on a vlog that stopped,
# and in the emails. Empty = no Help link.
SUPPORT_EMAIL=

# Password reset emails ("Forgot password?"). Empty SMTP_HOST = no email is sent; the reset link is printed in the
# terminal instead (fine on your own computer). Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your
# Gmail address, SMTP_PASSWORD=an app password (README step 7). In the cloud, use your email service's SMTP details.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Who the email comes from (empty = SMTP_USER)
MAIL_FROM=
# Pit Crew's public address, used in email links (reset, confirm, "Shorts ready"). Empty = the address the browser used,
# or http://localhost:8000 for emails sent from the background (fine locally).
# In the cloud set it (e.g. https://pitcrew.example.com): never build email links from the request's own address.
APP_URL=

# Instagram (optional, README step 6): the Meta app's "Instagram app ID" and "Instagram app secret".
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Where Instagram sends the creator back after connecting. Empty = http://localhost:8000/api/instagram/callback.
# Must match an "OAuth redirect URI" on the Meta app exactly (Meta may require https: use a tunnel or a server).
INSTAGRAM_REDIRECT_URI=
# Instagram Graph API version
INSTAGRAM_API_VERSION=v24.0
# Pit Crew's public https address, where Instagram downloads each Reel's video when it's posted (signed links that
# expire). Empty = the address of INSTAGRAM_REDIRECT_URI, else APP_URL. Locally that's the tunnel, so keep the tunnel
# running while Reels go out (README step 6). In the cloud: the site's address.
PUBLIC_URL=

# Keeping storage free (web/retention.py). 0 = keep forever. A day before a video or draft is deleted, the card says
# so and the creator gets an email (printed in the terminal when email isn't set up).
# A vlog's video: hours after the vlog was last edited. Its Shorts, thumbnails and transcript stay.
KEEP_ORIGINAL_HOURS=72
# Shorts that weren't posted: days after they were last edited.
KEEP_DRAFT_DAYS=30
# A posted Short's video file: days after it went out (its record, link and numbers stay).
KEEP_POSTED_DAYS=30
